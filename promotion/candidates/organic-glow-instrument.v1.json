    "heat": { "uniform": "uHeat", "type": "float", "default": 0.65, "min": 0, "max": 1, "step": 0.01, "keyframeable": true },
    "pointer": { "uniform": "uPointer", "type": "vec2", "default": [0, 0], "keyframeable": true },
