    "stretch": { "uniform": "uStretch", "type": "vec2", "default": [0, 0], "keyframeable": true },
    "twist": { "uniform": "uTwist", "type": "float", "default": 0, "min": -3.2, "max": 3.2, "step": 0.01, "keyframeable": true },
