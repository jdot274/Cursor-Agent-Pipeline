{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://refract.local/contracts/visual-asset.schema.json",
  "title": "Refract Visual Behavior Asset",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version",
    "type",
    "fragmentSource",
    "controls",
    "targets",
    "provenance"
  ],
  "properties": {
    "schemaVersion": { "const": "refract.visual-asset/1" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "type": { "enum": ["screen", "points", "lines", "mesh"] },
    "fragmentSource": { "type": "string", "minLength": 1 },
    "vertexSource": { "type": "string" },
    "controls": {
      "type": "object",
      "required": ["semantic", "interaction"],
      "properties": {
        "semantic": { "type": "array", "minItems": 3 },
        "interaction": { "type": "array" }
      }
    },
    "targets": { "type": "object" },
    "provenance": { "type": "object" }
  },
  "additionalProperties": true
}
